APP_ENV=development
LOG_LEVEL=INFO
DRY_RUN=true
DATA_DIR=./data
PM_BOT_UI_SESSION_SECRET=replace-with-long-random-secret
PM_BOT_UI_VIEWER_PASSWORD_HASH=pbkdf2_sha256$150000$<salt_hex>$<digest_hex>
PM_BOT_UI_OPERATOR_PASSWORD_HASH=pbkdf2_sha256$150000$<salt_hex>$<digest_hex>
PM_BOT_UI_ADMIN_PASSWORD_HASH=pbkdf2_sha256$150000$<salt_hex>$<digest_hex>
OPERATIONAL_DB_DSN=postgresql://pm_bot:pm_bot@127.0.0.1:5432/prediction_market_bot
SANDBOX_CHAIN_PRIVATE_KEY=replace-with-sandbox-private-key
PM_BOT_ACTOR_USER=staging-operator
PM_BOT_ACTOR_ROLE=operator
PM_BOT_ALERT_WEBHOOK_URL=https://hooks.example.invalid/services/replace-me
